# Copy this file to .env and fill in your own Supabase project's values.
# Project Settings -> API in the Supabase dashboard.
#
# EXPO_PUBLIC_* vars are exposed to the client bundle by Expo automatically.
# The anon key is meant to be public-ish (Row Level Security is what
# actually protects data) but still shouldn't be committed as a matter of
# hygiene. NEVER put the service_role key here or anywhere in the app.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
